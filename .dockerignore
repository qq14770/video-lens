# =============================================================================
#  .dockerignore —— 别把本地开发产物打进镜像
#  ---------------------------------------------------------------------------
#  这个文件直接影响镜像体积与构建速度，尤其别把 .remux_tmp（可能几个 GB 的
#  合并产物）和 __pycache__ 带进去。
# =============================================================================

# ---- Python 缓存与虚拟环境 ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- 运行期产物（最要紧的一条）----
# .remux_tmp 里可能有几个 GB 的 MP4/zip；state.json 是本机的定时计划，
# 不该被固化进镜像（容器里由 /data 卷提供）
backend/.remux_tmp/
backend/state.json
backend/state.json.broken
*.mp4
*.zip
*.m3u8
*.ts

# ---- 测试与工具产物 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 文档与仓库元数据（运行不需要）----
.git/
.gitignore
.github/
*.md
!README.md
LICENSE
docs/

# ---- 编辑器 / 系统垃圾 ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- 本地环境文件（可能含密钥，绝不进镜像）----
.env
.env.*
*.local

# ---- 备份与临时文件 ----
*.bak
*.tmp
*.log
