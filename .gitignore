# =============================================================================
#  .gitignore —— 用 git / scp 把项目传到飞牛 OS 时，别把本地运行产物带上
#  （镜像构建层面的忽略见 .dockerignore，两边口径保持一致）
# =============================================================================

# ---- Python 缓存与虚拟环境 ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- 运行期产物（最要紧）----
# .remux_tmp 里可能有几个 GB 的 MP4/zip；state.json 是本机测试计划，
# 部署后由容器 /data 卷提供，不该进仓库
backend/.remux_tmp/
backend/state.json
backend/state.json.broken
*.mp4
*.zip
*.m3u8
*.ts

# ---- 测试与工具产物 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 编辑器 / 系统垃圾 ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- 本地环境文件（可能含密钥，绝不进仓库）----
.env
.env.*
*.local

# ---- 备份与临时文件 ----
*.bak
*.tmp
*.log

# WorkBuddy 内部记忆（非项目源码，不进仓库）
.workbuddy/
